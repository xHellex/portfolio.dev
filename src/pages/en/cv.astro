---
import cv from "@/data/cv-en.json";

const { basics, work, skills, education, languages, certificates } = cv;

const MESES = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];

function formatDate(date: string | null) {
  if (!date) return "Present";
  const [year, month] = date.split("-");
  return `${MESES[Number(month) - 1]} ${year}`;
}

const idiomas = languages
  .map(({ language, fluency }) => `${language} (${fluency})`)
  .join(", ");
const certs = (certificates ?? []).map(({ name }) => name).join(", ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`CV of ${basics.name} — ${basics.label}`}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>CV — {basics.name}</title>
  </head>
  <body>
    <div class="toolbar no-print">
      <a href="/en">← Back to portfolio</a>
      <button type="button" onclick="window.print()">Print / Save as PDF</button
      >
    </div>

    <main class="cv">
      <header>
        <h1>{basics.name}</h1>
        <p class="contact">
          {basics.location.city}, {basics.location.region} · {basics.phone} · {
            basics.email
          }
        </p>
        <p class="links">
          {
            basics.profiles.map(({ network, url }, i) => (
              <>
                {i > 0 && " | "}
                <a href={url} target="_blank" rel="noopener noreferrer">
                  {network}
                </a>
              </>
            ))
          }
        </p>
      </header>

      <section>
        <h2>Professional Profile</h2>
        <p>{basics.cvSummary}</p>
      </section>

      <section>
        <h2>Professional Experience</h2>
        {
          work.map((job) => (
            <article>
              <h3>
                {job.position} | {job.name}
              </h3>
              <p class="meta">
                {job.location && <>{job.location} · </>}
                {formatDate(job.startDate)} - {formatDate(job.endDate)}
              </p>
              <ul>
                {job.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </section>

      <section>
        <h2>Technical Skills</h2>
        <ul class="skills">
          {
            skills.map(({ name, keywords }) => (
              <li>
                <strong>{name}:</strong> {keywords.join(", ")}
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Education</h2>
        <ul>
          {
            education.map(({ area, institution, endDate }) => (
              <li>
                {area} | {institution} | {endDate ? "Completed" : "In Progress"}
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Languages and Certifications</h2>
        <p>Languages: {idiomas}.</p>
        {certs && <p>Certifications: {certs}.</p>}
      </section>
    </main>

    <script>
      if (new URLSearchParams(location.search).get("print") === "1") {
        window.addEventListener("load", () => window.print());
      }
    </script>
  </body>
</html>

<style>
  :global(html) {
    font-family: Arial, Helvetica, sans-serif;
    background: #fff;
  }

  :global(body) {
    margin: 0;
    padding: 0;
    color: #111;
  }

  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 12px 24px;
    background: #f4f4f4;
    border-bottom: 1px solid #ddd;
    position: sticky;
    top: 0;
  }

  .toolbar a {
    color: #111;
    font-size: 0.9rem;
  }

  .toolbar button {
    font-family: inherit;
    font-size: 0.9rem;
    padding: 8px 16px;
    border-radius: 4px;
    border: 1px solid #111;
    background: #111;
    color: #fff;
    cursor: pointer;
  }

  .cv {
    max-width: 720px;
    margin: 0 auto;
    padding: 40px 24px 80px;
    line-height: 1.5;
  }

  header {
    text-align: center;
    margin-bottom: 24px;
  }

  h1 {
    margin: 0 0 4px;
    font-size: 1.8rem;
  }

  .contact,
  .links {
    margin: 2px 0;
    font-size: 0.9rem;
    color: #333;
  }

  .links a {
    color: #1a4fa0;
  }

  section {
    margin-bottom: 20px;
  }

  h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border-bottom: 2px solid #111;
    padding-bottom: 4px;
    margin-bottom: 12px;
  }

  article {
    margin-bottom: 14px;
    break-inside: avoid;
  }

  h3 {
    font-size: 0.95rem;
    margin: 0 0 2px;
  }

  .meta {
    margin: 0 0 6px;
    font-size: 0.85rem;
    color: #555;
  }

  ul {
    margin: 0;
    padding-left: 1.1em;
    font-size: 0.9rem;
  }

  ul.skills {
    padding-left: 0;
    list-style: none;
  }

  ul.skills li {
    margin-bottom: 4px;
  }

  li {
    margin-bottom: 4px;
  }

  p {
    margin: 0 0 8px;
    font-size: 0.9rem;
  }

  @media print {
    .no-print {
      display: none !important;
    }

    .cv {
      padding: 0;
      max-width: 100%;
    }

    a {
      color: #111 !important;
      text-decoration: none;
    }
  }

  @page {
    size: A4;
    margin: 16mm;
  }
</style>
