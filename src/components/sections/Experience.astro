---
import ExperienceItems from "../ExperienceItems.astro";
import type { CV } from "@/cvSchema";

interface Props {
  cv: CV;
}

const { cv } = Astro.props;

const { pathname } = Astro.url;
const isEnglish = pathname.startsWith("/en");

const MESES = isEnglish
  ? [
      "Jan",
      "Feb",
      "Mar",
      "Apr",
      "May",
      "Jun",
      "Jul",
      "Aug",
      "Sep",
      "Oct",
      "Nov",
      "Dec",
    ]
  : [
      "Ene",
      "Feb",
      "Mar",
      "Abr",
      "May",
      "Jun",
      "Jul",
      "Ago",
      "Sep",
      "Oct",
      "Nov",
      "Dic",
    ];

function formatDate(date: string | null) {
  if (!date) return isEnglish ? "Present" : "Presente";
  const [year, month] = date.split("-");
  return `${MESES[Number(month) - 1]} ${year}`;
}

const EXPERIENCE = cv.work.map((job) => ({
  date: `${formatDate(job.startDate)} - ${formatDate(job.endDate)}`,
  title: job.position,
  company: job.location ? `${job.name} · ${job.location}` : job.name,
  description: job.highlights,
}));
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="reveal">
        <ExperienceItems {...experience} />
      </li>
    ))
  }
</ol>
