---
import NextJS from "../../icons/NextJS.astro";
import Tailwind from "../../icons/Tailwind.astro";
import Boostrap from "../../icons/Boostrap.astro";
import Liferay from "../../icons/Liferay.astro";
import Wordpress from "../../icons/Wordpress.astro";
import Link from "../../icons/Link.astro";
import javascript from "../../icons/javascript.astro";
import LinkButton from "../LinkButton.astro";
import { cv } from "@/lib/cv";

const TAG_ICON: Record<string, any> = {
  "Next.js": NextJS,
  "Tailwind CSS": Tailwind,
  JavaScript: javascript,
  Bootstrap: Boostrap,
  Liferay: Liferay,
  WordPress: Wordpress,
};

const PROJECTS = cv.projects.map(({ name, description, highlights, url, image, tags }) => ({
  title: name,
  description: `${description}. ${highlights.join(", ")}.`,
  link: url,
  image,
  tags: (tags ?? []).map((tag) => ({ name: tag, icon: TAG_ICON[tag] })),
}));
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 border border-terminal-border md:group-hover:shadow-glow md:group-hover:border-neon-cyan/60">
            <img
              alt={title}
              class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
              loading="lazy"
              src={image}
            />
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-neon-cyan">
            {title}
          </h3>
          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-row mb-2 gap-x-2">
              {tags.map((tag) => (
                <li>
                  <span class="flex gap-x-2 items-center rounded-full text-xs bg-terminal-surface border border-terminal-border text-terminal-dim py-1 px-2">
                    <tag.icon class="size-4" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-terminal-dim text-pretty">
              {description}
            </div>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  Preview
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
