---
import NextJS from "../../icons/NextJS.astro";
import Tailwind from "../../icons/Tailwind.astro";
import Boostrap from "../../icons/Boostrap.astro";
import Liferay from "../../icons/Liferay.astro";
import Wordpress from "../../icons/Wordpress.astro";
import Link from "../../icons/Link.astro";
import GitHub from "../../icons/GitHub.astro";
import javascript from "../../icons/javascript.astro";
import LinkButton from "../LinkButton.astro";
import type { CV, Project } from "@/cvSchema";

interface Props {
  cv: CV;
}

const { cv } = Astro.props;

const TAG_ICON: Record<string, (_props: Record<string, unknown>) => unknown> = {
  "Next.js": NextJS,
  "Tailwind CSS": Tailwind,
  JavaScript: javascript,
  Bootstrap: Boostrap,
  Liferay: Liferay,
  WordPress: Wordpress,
};

const isEnglish = Astro.url.pathname.startsWith("/en");

const mapProject = ({
  name,
  description,
  highlights,
  url,
  image,
  imageMobile,
  tags,
  github,
  employer,
}: Project) => ({
  title: name,
  description: `${description}. ${highlights.join(", ")}.`,
  link: url,
  github,
  employer,
  image,
  imageMobile,
  tags: (tags ?? []).map((tag: string) => ({
    name: tag,
    icon: TAG_ICON[tag],
  })),
});

const personalProjects = cv.projects
  .filter(
    (project) =>
      project.isActive !== false && project.employer === "Proyecto Personal",
  )
  .map(mapProject);

const professionalProjects = cv.projects
  .filter(
    (project) =>
      project.isActive !== false && project.employer !== "Proyecto Personal",
  )
  .map(mapProject);
---

<div class="flex flex-col gap-y-24">
  <section class="flex flex-col gap-y-8">
    <h3
      class="text-xl font-bold text-terminal-dim flex items-center gap-x-4 mb-2"
    >
      <span class="w-8 h-px bg-terminal-border"></span>
      {isEnglish ? "Open Source & Labs" : "Proyectos Personales"}
    </h3>
    <div class="flex flex-col gap-y-16">
      {
        personalProjects.map(
          ({
            image,
            imageMobile,
            title,
            description,
            tags,
            link,
            github,
            employer,
          }) => (
            <article class="reveal flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0 p-4 rounded-xl transition duration-500 hover:bg-terminal-border/10">
              <div class="w-full md:w-1/2">
                <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 border border-terminal-border md:group-hover:shadow-glow md:group-hover:border-neon-cyan/60 md:group-hover:bg-neon-cyan/5">
                  <div class="relative w-full h-full aspect-video bg-terminal-surface/20 p-2 overflow-hidden rounded-xl">
                    <img
                      alt={title}
                      class="absolute inset-x-2 inset-y-2 lg:inset-x-4 lg:inset-y-4 w-[90%] h-auto rounded border border-terminal-border shadow-md transition duration-500 md:group-hover:scale-105"
                      loading="lazy"
                      src={image}
                    />
                    <img
                      alt={`${title} mobile aspect`}
                      class="absolute bottom-[-15%] right-[-5%] w-[35%] aspect-[9/19] object-cover object-left-top rounded-[15%] border-[6px] border-terminal-bg shadow-2xl transition duration-500 md:group-hover:-translate-y-4 md:group-hover:scale-110 z-10"
                      loading="lazy"
                      src={imageMobile || image}
                    />
                  </div>
                </div>
              </div>

              <div class="w-full md:w-1/2 md:max-w-lg">
                <h3 class="text-2xl font-bold text-neon-cyan">{title}</h3>
                {employer && (
                  <h4 class="text-xs font-semibold text-terminal-dim uppercase tracking-widest mt-1 mb-2">
                    {employer}
                  </h4>
                )}
                <div class="flex flex-wrap mt-2">
                  <ul class="flex flex-row mb-2 gap-x-2">
                    {tags.map((tag: any) => (
                      <li>
                        <span class="flex gap-x-2 items-center rounded-full text-xs bg-terminal-surface border border-terminal-border text-terminal-dim py-1 px-2">
                          {tag.icon && <tag.icon class="size-4" />}
                          {tag.name}
                        </span>
                      </li>
                    ))}
                  </ul>

                  <div class="mt-2 text-terminal-dim text-pretty">
                    {description}
                  </div>
                  <footer class="flex items-end justify-start mt-4 gap-x-4">
                    {github && (
                      <LinkButton href={github}>
                        <GitHub class="size-4" />
                        Code
                      </LinkButton>
                    )}
                    {link && (
                      <LinkButton href={link}>
                        <Link class="size-4" />
                        Preview
                      </LinkButton>
                    )}
                  </footer>
                </div>
              </div>
            </article>
          ),
        )
      }
    </div>
  </section>

  <section class="flex flex-col gap-y-8">
    <h3
      class="text-xl font-bold text-terminal-dim flex items-center gap-x-4 mb-2"
    >
      <span class="w-8 h-px bg-terminal-border"></span>
      {isEnglish ? "Professional Work" : "Proyectos Profesionales"}
    </h3>
    <div class="flex flex-col gap-y-16">
      {
        professionalProjects.map(
          ({
            image,
            imageMobile,
            title,
            description,
            tags,
            link,
            github,
            employer,
          }) => (
            <article class="reveal flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0 p-4 rounded-xl transition duration-500 hover:bg-terminal-border/10">
              <div class="w-full md:w-1/2">
                <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 border border-terminal-border md:group-hover:shadow-glow md:group-hover:border-neon-cyan/60 md:group-hover:bg-neon-cyan/5">
                  <div class="relative w-full h-full aspect-video bg-terminal-surface/20 p-2 overflow-hidden rounded-xl">
                    <img
                      alt={title}
                      class="absolute inset-x-2 inset-y-2 lg:inset-x-4 lg:inset-y-4 w-[90%] h-auto rounded border border-terminal-border shadow-md transition duration-500 md:group-hover:scale-105"
                      loading="lazy"
                      src={image}
                    />
                    <img
                      alt={`${title} mobile aspect`}
                      class="absolute bottom-[-15%] right-[-5%] w-[35%] aspect-[9/19] object-cover object-left-top rounded-[15%] border-[6px] border-terminal-bg shadow-2xl transition duration-500 md:group-hover:-translate-y-4 md:group-hover:scale-110 z-10"
                      loading="lazy"
                      src={imageMobile || image}
                    />
                  </div>
                </div>
              </div>

              <div class="w-full md:w-1/2 md:max-w-lg">
                <h3 class="text-2xl font-bold text-neon-cyan">{title}</h3>
                {employer && (
                  <h4 class="text-xs font-semibold text-terminal-dim uppercase tracking-widest mt-1 mb-2">
                    {employer}
                  </h4>
                )}
                <div class="flex flex-wrap mt-2">
                  <ul class="flex flex-row mb-2 gap-x-2">
                    {tags.map((tag: any) => (
                      <li>
                        <span class="flex gap-x-2 items-center rounded-full text-xs bg-terminal-surface border border-terminal-border text-terminal-dim py-1 px-2">
                          {tag.icon && <tag.icon class="size-4" />}
                          {tag.name}
                        </span>
                      </li>
                    ))}
                  </ul>

                  <div class="mt-2 text-terminal-dim text-pretty">
                    {description}
                  </div>
                  <footer class="flex items-end justify-start mt-4 gap-x-4">
                    {github && (
                      <LinkButton href={github}>
                        <GitHub class="size-4" />
                        Code
                      </LinkButton>
                    )}
                    {link && (
                      <LinkButton href={link}>
                        <Link class="size-4" />
                        Preview
                      </LinkButton>
                    )}
                  </footer>
                </div>
              </div>
            </article>
          ),
        )
      }
    </div>
  </section>
</div>
