---
import Badge from "../Badge.astro";
import LinkedIn from "../../icons/LinkedIn.astro";
import MailIcon from "../../icons/Mail.astro";
import SocialPill from "../SocialPill.astro";
import GitHub from "../../icons/GitHub.astro";
import CV from "../../icons/CV.astro";
import { cv } from "@/lib/cv";

const { name, label, location, profiles, email } = cv.basics;
const linkedUrl = profiles.find(({ network }) => network === "LinkedIn")?.url;
const githubUrl = profiles.find(({ network }) => network === "GitHub")?.url;
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <a
      href={linkedUrl}
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Disponibilidad Inmediata</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-600 sm:text-5xl dark:text-white"
  >
    Hey, soy {name}
  </h1>
  <p
    class="mt-6 text-xl text-gray-500 dark:[&>strong]:text-blue-400 [&>strong]:text-blue-500 [&>strong]:font-semibold dark:text-gray-200 text-pretty"
  >
    <strong>{label}</strong>. De {location.city}, {location.region}. Conectando
    interfaces en React/Astro con APIs y servicios en Java y Spring Boot.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href={`mailto:${email}`}>
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    {linkedUrl && (
      <SocialPill href={linkedUrl}>
        <LinkedIn class="size-4" />
        LinkedIn
      </SocialPill>
    )}
    {githubUrl && (
      <SocialPill href={githubUrl}>
        <GitHub class="size-4" />
        GitHub
      </SocialPill>
    )}

    <SocialPill href="/cv">
      <CV class="size-4" />
      CV-Print
    </SocialPill>
  </nav>
</div>
