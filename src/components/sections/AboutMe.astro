---
const { cv } = Astro.props;
const { name, image, summary } = cv.basics;
---

<article
  class="reveal flex flex-col items-center justify-center gap-8 text-terminal-dim"
>
  <img
    width="200"
    height="200"
    src={image}
    alt={name}
    class="order-1 object-cover w-64 h-full p-1 md:order-2 rotate-3 lg:p-2 lg:w-64 aspect-square rounded-2xl bg-terminal-surface ring-1 ring-terminal-border"
    style="object-position: 50% 50%"
  />
  <div class="[&>p]:mb-4 text-pretty order-2 md:order-1">
    <p>{summary}</p>
  </div>
</article>
