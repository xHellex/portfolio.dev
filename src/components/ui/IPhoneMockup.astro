---
interface Props {
    src?: string;
    width?: number;
    height?: number;
    class?: string;
}

const { src, width = 433, height = 882, class: className } = Astro.props;
---

<div class={`relative ${className}`}>
    <svg
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        viewBox={`0 0 ${width} ${height}`}
        class="w-full h-auto drop-shadow-2xl"
    >
        <path
            d="M2 73C2 32.6832 34.6832 0 75 0H357C397.317 0 430 32.6832 430 73V809C430 849.317 397.317 882 357 882H75C34.6832 882 2 849.317 2 809V73Z"
            class="fill-[#1A1A1A]"></path>
        <path
            d="M6 74C6 35.3401 37.3401 4 76 4H356C394.66 4 426 35.3401 426 74V808C426 846.66 394.66 878 356 878H76C37.3401 878 6 846.66 6 808V74Z"
            class="fill-[#000000]"></path>
        <path
            d="M21.25 75C21.25 44.2101 46.2101 19.25 77 19.25H355C385.79 19.25 410.75 44.2101 410.75 75V807C410.75 837.79 385.79 862.75 355 862.75H77C46.2101 862.75 21.25 837.79 21.25 807V75Z"
            class="fill-[#2B2B2B] stroke-[#2B2B2B] stroke-[0.5]"></path>
        {
            src && (
                <image
                    x="21.25"
                    y="19.25"
                    width="389.5"
                    height="843.5"
                    preserveAspectRatio="xMidYMin slice"
                    style="clip-path: url(#roundedCorners)"
                    href={src}
                />
            )
        }
        <!-- Dynamic Island Notch -->
        <path
            d="M174 15H258V18C258 24.627 252.627 30 246 30H186C179.373 30 174 24.627 174 18V15Z"
            class="fill-black"></path>
        <path
            d="M242 22.5C242 24.985 240.209 27 238 27C235.791 27 234 24.985 234 22.5C234 20.015 235.791 18 238 18C240.209 18 242 20.015 242 22.5Z"
            class="fill-[#1F1F1F]"></path>

        <defs>
            <clipPath id="roundedCorners">
                <rect
                    x="21.25"
                    y="19.25"
                    width="389.5"
                    height="843.5"
                    rx="55.75"
                    ry="55.75"></rect>
            </clipPath>
        </defs>
    </svg>
</div>
