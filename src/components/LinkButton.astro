---
const { href } = Astro.props;
---

<a
  target="_blank"
  href={href}
  role="link"
  class="inline-flex bg-terminal-surface text-terminal-text border-terminal-border items-center justify-center gap-2 px-3 py-2 space-x-2 text-base transition border rounded text-md hover:border-neon-cyan/60 hover:text-neon-cyan hover:shadow-glow group max-w-fit focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-neon-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-terminal-bg"
>
  <slot />
</a>
